<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/global_settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/preview_label"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_preview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:cardBackgroundColor="#F5F5F5"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#DDDDDD"
            android:layout_marginBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/preview_content_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">
                    <View
                        android:id="@+id/preview_progress"
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#40000000" />
                    <TextView
                        android:id="@+id/preview_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sample_data"
                        android:textSize="12sp"
                        android:textColor="#888888" />
                </LinearLayout>

                <!-- Preview of the Controls Panel -->
                <LinearLayout
                    android:id="@+id/preview_panel"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_gravity="bottom"
                    android:background="#33000000"
                    android:gravity="center"
                    android:paddingHorizontal="8dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_settings" android:background="@drawable/widget_button_background" android:padding="4dp" android:layout_margin="2dp" app:tint="@android:color/black" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_remove" android:background="@drawable/widget_button_background" android:padding="4dp" android:layout_margin="2dp" app:tint="@android:color/black" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_add" android:background="@drawable/widget_button_background" android:padding="4dp" android:layout_margin="2dp" app:tint="@android:color/black" />
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_widget_refresh" android:background="@drawable/widget_button_background" android:padding="4dp" android:layout_margin="2dp" app:tint="@android:color/black" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Widget Geometry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_radius_label"
                android:textStyle="bold"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/txt_radius_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8dp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="32"
            android:progress="8"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/content_padding_label"
                android:textStyle="bold"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/txt_padding_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4dp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_padding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="24"
            android:progress="4"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Panel Appearance -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Controls Panel Appearance"
            android:textStyle="bold"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardElevation="2dp"
                app:cardCornerRadius="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="#888888">
                <View
                    android:id="@+id/view_panel_color_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txt_panel_color_hex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/transparency_label"
                android:textStyle="bold"
                android:textSize="16sp" />
            <TextView
                android:id="@+id/txt_panel_alpha_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20%"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_panel_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="20"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/global_settings_note"
            android:textSize="12sp"
            android:textColor="@android:color/darker_gray" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
